{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RDAT Copilot",
  "version": "0.3.1",
  "identifier": "com.waleedmandour.rdat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RDAT: Translation Copilot - Bidirectional EN↔AR CAT Assistant",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:11434 http://localhost:11434 https://generativelanguage.googleapis.com https://*.googleapis.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "Copyright (c) 2026 Dr. Waleed Mandour",
    "category": "Productivity",
    "shortDescription": "Professional bidirectional EN↔AR CAT environment",
    "longDescription": "AI-powered, desktop translation workspace for professional bidirectional English↔Arabic translation workflows. Combines a segmented translation editor with a three-tier predictive ghost-text pipeline powered by local Ollama LLMs, with full AR→EN and EN→AR support.",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": ["en-US"]
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/waleedmandour/rdat/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4MTUxRkMyOUQ0QkI3OUUKUldTZXQwdWR3aDhWR1BFbFdEdThKdlpnR1dqWGVCUHhqbHBrVzlNQkROeFFGbmxkcFo2MkRJb1cK"
    },
    "shell": {
      "open": "^((mailto:\\w+)|(tel:\\w+)|(https?://\\w+)).+"
    }
  }
}
