{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RDAT Copilot",
  "version": "0.2.0",
  "identifier": "com.waleedmandour.rdat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RDAT Copilot — English-Arabic CAT Assistant",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "Copyright (c) 2026 Dr. Waleed Mandour",
    "category": "Productivity",
    "shortDescription": "Professional English-Arabic CAT environment",
    "longDescription": "AI-powered, desktop translation workspace for professional English-to-Arabic translation workflows. Combines a segmented translation editor with a three-tier predictive ghost-text pipeline powered by local Ollama LLMs.",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": ["en-US"]
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/waleedmandour/rdat/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
